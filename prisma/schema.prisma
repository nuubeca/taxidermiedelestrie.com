// Prisma schema for the Mouldec / Taxidermie de l'Estrie WooCommerce migration.
// Each model preserves the WordPress source ID (wpPostId / wpTermId) for traceability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum ProductType {
  SIMPLE
  VARIABLE
  GROUPED
  EXTERNAL
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  PRIVATE
  PENDING
  TRASH
}

// ---------- Taxonomies ----------

model Category {
  id           Int        @id @default(autoincrement())
  wpTermId     Int?       @unique // null = créée dans la gestion
  slug         String     @unique
  name         String
  description  String?
  parentId     Int?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  imageUrl     String?
  position     Int        @default(0)
  productCount Int        @default(0)
  products     Product[]  @relation("ProductCategories")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
}

model Tag {
  id           Int       @id @default(autoincrement())
  wpTermId     Int?      @unique // null = créé dans la gestion
  slug         String    @unique
  name         String
  productCount Int       @default(0)
  products     Product[] @relation("ProductTags")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Products ----------

model Product {
  id                Int           @id @default(autoincrement())
  wpPostId          Int?          @unique // null = créé dans la gestion
  slug              String        @unique
  name              String
  description       String?
  shortDescription  String?
  type              ProductType   @default(SIMPLE)
  status            ProductStatus @default(PUBLISHED)
  featured          Boolean       @default(false)
  catalogVisibility String        @default("visible")

  sku String?

  // Pricing — for variable products these may be null; the variants drive the range.
  price        Decimal?  @db.Decimal(10, 2)
  regularPrice Decimal?  @db.Decimal(10, 2)
  salePrice    Decimal?  @db.Decimal(10, 2)
  saleStart    DateTime?
  saleEnd      DateTime?

  // Stock
  manageStock      Boolean @default(false)
  stockQuantity    Int?
  stockStatus      String  @default("instock")
  backorders       String  @default("no")
  soldIndividually Boolean @default(false)

  // Dimensions
  weight Decimal? @db.Decimal(10, 3)
  length Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)

  // Tax / shipping
  taxStatus     String  @default("taxable")
  taxClass      String?
  shippingClass String?

  // Purchase note
  purchaseNote String?

  // SEO (Yoast)
  metaTitle       String?
  metaDescription String?

  // Images — URLs absolues vers le WP live; rempli par le download script plus tard.
  primaryImageUrl  String?
  galleryImageUrls String[]

  // Relations
  categories Category[]         @relation("ProductCategories")
  tags       Tag[]              @relation("ProductTags")
  attributes ProductAttribute[]
  variants   Variant[]

  // Metadata
  totalSales    Int      @default(0)
  averageRating Decimal? @db.Decimal(3, 2)
  ratingCount   Int      @default(0)

  // Audit
  wpCreatedAt  DateTime?
  wpModifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([featured])
}

model ProductAttribute {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // ex: "Dimension (mm)"
  slug        String // ex: "dimension-mm" — clé interne WooCommerce
  position    Int      @default(0)
  isVisible   Boolean  @default(true)
  isVariation Boolean  @default(false)
  options     String[] // ex: ["14mm","16mm","18mm","20mm","22mm"]

  @@unique([productId, slug])
  @@index([productId])
}

model Variant {
  id        Int     @id @default(autoincrement())
  wpPostId  Int?    @unique // null = créée dans la gestion
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku          String?
  price        Decimal? @db.Decimal(10, 2)
  regularPrice Decimal? @db.Decimal(10, 2)
  salePrice    Decimal? @db.Decimal(10, 2)

  manageStock   Boolean @default(false)
  stockQuantity Int?
  stockStatus   String  @default("instock")

  weight Decimal? @db.Decimal(10, 3)
  length Decimal? @db.Decimal(10, 2)
  width  Decimal? @db.Decimal(10, 2)
  height Decimal? @db.Decimal(10, 2)

  imageUrl String?

  // Mapping attribut slug → option choisie pour cette variante
  // Ex: { "dimension-mm": "16mm", "couleur": "rouge" }
  attributes Json @default("{}")

  position Int     @default(0)
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ---------- Media ----------

model MediaAsset {
  id            Int       @id @default(autoincrement())
  wpPostId      Int?      @unique // null = téléversé hors WordPress
  originalUrl   String // URL absolue sur WordPress live
  filePath      String // ex: "2019/09/fullsizeoutput_94e.jpeg"
  localPath     String? // rempli par 03-download-media.ts
  publicUrl     String? // URL publique Supabase Storage, rempli par 04-upload-media-storage.ts
  storageBucket String? // bucket Supabase Storage (ex: "videos" privé)
  storagePath   String? // clé dans ce bucket
  altText       String?
  title         String?
  mimeType      String?
  width         Int?
  height        Int?
  fileSize      Int?
  downloadedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Migration log (utile pour debug + idempotence) ----------

model MigrationRun {
  id          Int       @id @default(autoincrement())
  step        String // "transform" | "seed" | "media"
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  itemsTotal  Int       @default(0)
  itemsOk     Int       @default(0)
  itemsFailed Int       @default(0)
  notes       String?
}

// ---------- Comptes (liés à Supabase Auth par l'UUID auth.users.id) ----------

enum UserRole {
  ADMIN
  CUSTOMER
}

model Profile {
  id        String   @id @db.Uuid // = auth.users.id
  email     String   @unique
  role      UserRole @default(CUSTOMER)
  firstName String?
  lastName  String?
  company   String?
  phone     String?
  billing   Json? // snapshot adresse de facturation (AddressSnapshot)
  shipping  Json? // snapshot adresse de livraison (AddressSnapshot)
  wpUserId  Int?     @unique
  wpLogin   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ---------- Commandes (demandes de commande, sans paiement en ligne) ----------

enum OrderStatus {
  RECEIVED // reçue, à traiter par le commis
  PROCESSING // en préparation / client contacté
  COMPLETED // remise ou expédiée
  CANCELLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

model Order {
  id            Int               @id @default(autoincrement())
  number        String            @unique // ex: "TDE-000123" — ou l'ID WooCommerce d'origine
  wpOrderId     Int?              @unique
  profileId     String?           @db.Uuid
  profile       Profile?          @relation(fields: [profileId], references: [id], onDelete: SetNull)
  status        OrderStatus       @default(RECEIVED)
  fulfillment   FulfillmentMethod @default(PICKUP)
  shippingLabel String? // libellé du mode d’expédition choisi

  // Snapshot client au moment de la commande (le profil peut changer ensuite)
  email     String
  firstName String?
  lastName  String?
  company   String?
  phone     String?
  billing   Json?
  shipping  Json?

  customerNote String?
  subtotal     Decimal @db.Decimal(10, 2) // avant taxes
  currency     String  @default("CAD")

  items OrderItem[]
  notes OrderNote[]

  placedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([status])
  @@index([email])
  @@index([placedAt])
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int? // référence souple : le produit peut être supprimé ensuite
  variantId  Int?
  name       String // snapshot du nom au moment de la commande
  sku        String?
  attributes Json? // ex: { "dimension-mm": "16mm" }
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  lineTotal  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model OrderNote {
  id                Int      @id @default(autoincrement())
  orderId           Int
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author            String // "system" | courriel de l'admin | "woocommerce"
  content           String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([orderId])
}
